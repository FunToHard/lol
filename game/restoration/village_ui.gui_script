--- GUI script driving the woodland village renovation, 2.5D diorama, guide dialogue, and area navigation.
-- Binds village_controller, dialogue_controller, and area_catalog data directly to Defold GUI visual nodes.

local village_controller = require("game.restoration.village_controller")
local save_manager = require("game.persistence.save_manager")
local ledger = require("game.economy.ledger")
local village_state = require("game.restoration.village_state")
local companion = require("game.restoration.companion")
local prop_layer_controller = require("game.restoration.prop_layer_controller")
local lore_catalog = require("game.restoration.lore_catalog")
local dialogue_controller = require("game.restoration.dialogue_controller")
local area_catalog = require("game.restoration.area_catalog")

--- Updates all visual GUI nodes based on current village_controller, dialogue, and area state.
-- @param self table GUI script instance table.
local function refresh_view(self)
    if not self.ctrl then return end
    local view = village_controller.get_view_data(self.ctrl)
    local completed_count = #(self.village.completed_tasks or {})

    -- Currency & Area Progress
    gui.set_text(self.txt_stars, tostring(view.stars or 0))
    gui.set_text(self.txt_coins, tostring(view.coins or 0))

    if self.active_area_id == "area_1" then
        gui.set_text(self.area_title, string.format("Hearthstone Courtyard (%d/12)", completed_count))
    elseif self.active_area_id == "area_2" then
        gui.set_text(self.area_title, "Whispering Willow Pond")
    elseif self.active_area_id == "area_3" then
        gui.set_text(self.area_title, "Firefly Ridge")
    end

    -- Area Tabs Bar
    local current_level = (self.save_data.player and self.save_data.player.current_level) or 1
    local unl_2 = area_catalog.is_area_unlocked("area_2", completed_count, current_level)
    local unl_3 = area_catalog.is_area_unlocked("area_3", completed_count, current_level)

    gui.set_color(self.tab_area_1, self.active_area_id == "area_1" and vmath.vector4(0.25, 0.55, 0.35, 1.0) or vmath.vector4(0.18, 0.25, 0.20, 0.85))
    gui.set_text(self.lbl_tab_1, "1. Courtyard")

    if unl_2 then
        gui.set_color(self.tab_area_2, self.active_area_id == "area_2" and vmath.vector4(0.2, 0.45, 0.55, 1.0) or vmath.vector4(0.18, 0.25, 0.30, 0.85))
        gui.set_text(self.lbl_tab_2, "2. Willow Pond")
    else
        gui.set_color(self.tab_area_2, vmath.vector4(0.15, 0.15, 0.18, 0.6))
        gui.set_text(self.lbl_tab_2, "🔒 Willow Pond")
    end

    if unl_3 then
        gui.set_color(self.tab_area_3, self.active_area_id == "area_3" and vmath.vector4(0.45, 0.35, 0.55, 1.0) or vmath.vector4(0.25, 0.20, 0.35, 0.85))
        gui.set_text(self.lbl_tab_3, "3. Firefly Ridge")
    else
        gui.set_color(self.tab_area_3, vmath.vector4(0.15, 0.15, 0.18, 0.6))
        gui.set_text(self.lbl_tab_3, "🔒 Firefly Ridge")
    end

    -- Companion Speech Bubble
    local c_name = view.companion_name or "Pip"
    local c_dialogue = view.companion_dialogue or "Welcome to Hearthstone Courtyard!"
    gui.set_text(self.companion_txt, string.format("%s: %s", c_name, c_dialogue))

    -- Interactive NPC Guide (Elder Bramble)
    if self.npc_bramble then
        local is_speaking = self.dialogue and self.dialogue.is_active and self.dialogue.current_speaker == "bramble"
        local b_scale = is_speaking and 1.15 or 1.0
        gui.set_scale(self.npc_bramble, vmath.vector3(b_scale, b_scale, 1.0))
    end

    -- Narrative Dialogue Modal Box
    if self.dialogue then
        local d_view = dialogue_controller.get_view_data(self.dialogue)
        local d_active = d_view.is_active
        gui.set_enabled(self.dialogue_backdrop, d_active)
        gui.set_enabled(self.dialogue_card, d_active)
        gui.set_enabled(self.dialogue_avatar, d_active)
        gui.set_enabled(self.dialogue_speaker, d_active)
        gui.set_enabled(self.dialogue_text, d_active)
        gui.set_enabled(self.dialogue_prompt, d_active)

        if d_active then
            local spk_title = d_view.speaker_title and (" - " .. d_view.speaker_title) or ""
            gui.set_text(self.dialogue_speaker, (d_view.speaker_name or "Elder") .. spk_title)
            gui.set_text(self.dialogue_text, d_view.text or "")
            gui.set_text(self.dialogue_prompt, d_view.prompt_text or "Tap anywhere to continue ▶")
            if d_view.avatar_texture then
                pcall(gui.play_flipbook, self.dialogue_avatar, d_view.avatar_texture)
            end
        end
    end

    -- Active Task Drawer
    local show_drawer = view.drawer_open
    gui.set_enabled(self.drawer_root, show_drawer)
    gui.set_enabled(self.task_title, show_drawer)
    gui.set_enabled(self.task_cost_badge, show_drawer)
    gui.set_enabled(self.task_cost_star, show_drawer)
    gui.set_enabled(self.task_cost_txt, show_drawer)
    gui.set_enabled(self.btn_restore, show_drawer)
    gui.set_enabled(self.lbl_restore, show_drawer)

    if show_drawer then
        if view.active_task then
            gui.set_text(self.task_title, view.active_task.title)
            gui.set_text(self.task_cost_txt, string.format("%d Spark%s", view.active_task.cost, view.active_task.cost > 1 and "s" or ""))
            if view.active_task.can_afford then
                gui.set_color(self.btn_restore, vmath.vector4(1, 1, 1, 1))
                gui.set_text(self.lbl_restore, "RESTORE")
            else
                gui.set_color(self.btn_restore, vmath.vector4(0.5, 0.5, 0.5, 0.6))
                gui.set_text(self.lbl_restore, "NEED SPARKS")
            end
        else
            gui.set_text(self.task_title, "All Courtyard Tasks Complete!")
            gui.set_text(self.task_cost_txt, "Max Level")
            gui.set_color(self.btn_restore, vmath.vector4(0.5, 0.5, 0.5, 0.4))
            gui.set_text(self.lbl_restore, "COMPLETED")
        end
    end

    -- 3-Style Picker Modal
    local show_picker = (view.picker_open and view.picker ~= nil)
    gui.set_enabled(self.picker_backdrop, show_picker)
    gui.set_enabled(self.picker_card, show_picker)
    gui.set_enabled(self.picker_title, show_picker)
    gui.set_enabled(self.picker_subtitle, show_picker)
    gui.set_enabled(self.btn_cancel_picker, show_picker)
    gui.set_enabled(self.lbl_cancel_picker, show_picker)
    gui.set_enabled(self.style_1_card, show_picker)
    gui.set_enabled(self.style_1_lbl, show_picker)
    gui.set_enabled(self.style_1_tag, show_picker)
    gui.set_enabled(self.style_2_card, show_picker)
    gui.set_enabled(self.style_2_lbl, show_picker)
    gui.set_enabled(self.style_2_tag, show_picker)
    gui.set_enabled(self.style_3_card, show_picker)
    gui.set_enabled(self.style_3_lbl, show_picker)
    gui.set_enabled(self.style_3_tag, show_picker)
    gui.set_enabled(self.btn_confirm_style, show_picker)
    gui.set_enabled(self.lbl_confirm_style, show_picker)

    if show_picker then
        gui.set_text(self.picker_subtitle, view.picker.task_title)
        local s1 = view.picker.styles[1]
        local s2 = view.picker.styles[2]
        local s3 = view.picker.styles[3]
        if s1 then
            gui.set_text(self.style_1_lbl, "1. " .. s1.name)
            gui.set_enabled(self.style_1_check, s1.is_selected)
            gui.set_color(self.style_1_card, s1.is_selected and vmath.vector4(1, 0.95, 0.7, 1) or vmath.vector4(1, 1, 1, 1))
        end
        if s2 then
            gui.set_text(self.style_2_lbl, "2. " .. s2.name)
            gui.set_enabled(self.style_2_check, s2.is_selected)
            gui.set_color(self.style_2_card, s2.is_selected and vmath.vector4(1, 0.95, 0.7, 1) or vmath.vector4(1, 1, 1, 1))
        end
        if s3 then
            gui.set_text(self.style_3_lbl, "3. " .. s3.name)
            gui.set_enabled(self.style_3_check, s3.is_selected)
            gui.set_color(self.style_3_card, s3.is_selected and vmath.vector4(1, 0.95, 0.7, 1) or vmath.vector4(1, 1, 1, 1))
        end
    else
        gui.set_enabled(self.style_1_check, false)
        gui.set_enabled(self.style_2_check, false)
        gui.set_enabled(self.style_3_check, false)
    end

    -- 2.5D Diorama Restorative Props & Companion
    if self.prop_nodes and self.village then
        local snapshot = prop_layer_controller.get_diorama_snapshot(
            self.village.completed_tasks or {},
            self.village.chosen_styles or {},
            self.companion
        )
        for _, p in ipairs(snapshot.props) do
            local entry = self.prop_nodes[p.prop_id]
            if entry and entry.node then
                if p.is_restored then
                    gui.set_color(entry.node, vmath.vector4(p.tint.r, p.tint.g, p.tint.b, 1.0))
                    gui.set_scale(entry.node, vmath.vector3(p.scale.x, p.scale.y, 1.0))
                else
                    gui.set_color(entry.node, vmath.vector4(0.35, 0.42, 0.38, 0.4))
                    gui.set_scale(entry.node, vmath.vector3(p.scale.x * 0.85, p.scale.y * 0.85, 1.0))
                end
            end
        end
        if self.companion_diorama then
            local emote = self.companion and self.companion.current_emote or "idle"
            if emote == "celebrate" then
                gui.set_scale(self.companion_diorama, vmath.vector3(1.25, 1.25, 1.0))
                gui.set_color(self.companion_diorama, vmath.vector4(1.0, 1.0, 0.7, 1.0))
            elseif emote == "curious" then
                gui.set_scale(self.companion_diorama, vmath.vector3(1.1, 1.1, 1.0))
                gui.set_color(self.companion_diorama, vmath.vector4(0.8, 1.0, 0.9, 1.0))
            else
                gui.set_scale(self.companion_diorama, vmath.vector3(1.0, 1.0, 1.0))
                gui.set_color(self.companion_diorama, vmath.vector4(1.0, 0.88, 0.65, 1.0))
            end
        end
    end
end

--- Initializes GUI nodes, input focus, persistent state, and guide triggers.
-- @param self table GUI script instance table.
function init(self)
    msg.post(".", "acquire_input_focus")

    -- Top bar & currency nodes
    self.top_bar = gui.get_node("top_bar")
    self.btn_back = gui.get_node("btn_back")
    self.lbl_back = gui.get_node("lbl_back")
    self.txt_stars = gui.get_node("txt_stars")
    self.txt_coins = gui.get_node("txt_coins")
    self.area_title = gui.get_node("area_title")

    -- Area Tabs Bar
    self.tab_area_1 = gui.get_node("tab_area_1")
    self.tab_area_2 = gui.get_node("tab_area_2")
    self.tab_area_3 = gui.get_node("tab_area_3")
    self.lbl_tab_1 = gui.get_node("lbl_tab_1")
    self.lbl_tab_2 = gui.get_node("lbl_tab_2")
    self.lbl_tab_3 = gui.get_node("lbl_tab_3")
    self.active_area_id = "area_1"

    -- 2.5D Diorama Canvas, NPCs & Props
    pcall(function()
        self.village_bg = gui.get_node("village_bg")
        self.courtyard_clearing = gui.get_node("courtyard_clearing")
        self.companion_diorama = gui.get_node("companion_diorama")
        self.npc_bramble = gui.get_node("npc_bramble")
    end)
    self.prop_nodes = {}
    for _, prop_def in ipairs(prop_layer_controller.PROPS) do
        local ok, node = pcall(gui.get_node, "prop_" .. prop_def.prop_id)
        if ok and node then
            self.prop_nodes[prop_def.prop_id] = { node = node, def = prop_def }
        end
    end

    -- Narrative Dialogue Modal Box nodes
    pcall(function()
        self.dialogue_backdrop = gui.get_node("dialogue_backdrop")
        self.dialogue_card = gui.get_node("dialogue_card")
        self.dialogue_avatar = gui.get_node("dialogue_avatar")
        self.dialogue_speaker = gui.get_node("dialogue_speaker")
        self.dialogue_text = gui.get_node("dialogue_text")
        self.dialogue_prompt = gui.get_node("dialogue_prompt")
    end)
    self.dialogue = dialogue_controller.new()

    -- Companion speech bubble
    self.companion_bubble = gui.get_node("companion_bubble")
    self.companion_txt = gui.get_node("companion_txt")

    -- Task drawer nodes
    self.drawer_root = gui.get_node("drawer_root")
    self.drawer_tab = gui.get_node("drawer_tab")
    self.drawer_tab_lbl = gui.get_node("drawer_tab_lbl")
    self.task_title = gui.get_node("task_title")
    self.task_cost_badge = gui.get_node("task_cost_badge")
    self.task_cost_star = gui.get_node("task_cost_star")
    self.task_cost_txt = gui.get_node("task_cost_txt")
    self.btn_restore = gui.get_node("btn_restore")
    self.lbl_restore = gui.get_node("lbl_restore")

    -- 3-Style Picker modal nodes
    self.picker_backdrop = gui.get_node("picker_backdrop")
    self.picker_card = gui.get_node("picker_card")
    self.picker_title = gui.get_node("picker_title")
    self.picker_subtitle = gui.get_node("picker_subtitle")
    self.btn_cancel_picker = gui.get_node("btn_cancel_picker")
    self.lbl_cancel_picker = gui.get_node("lbl_cancel_picker")
    self.style_1_card = gui.get_node("style_1_card")
    self.style_1_lbl = gui.get_node("style_1_lbl")
    self.style_1_tag = gui.get_node("style_1_tag")
    self.style_1_check = gui.get_node("style_1_check")
    self.style_2_card = gui.get_node("style_2_card")
    self.style_2_lbl = gui.get_node("style_2_lbl")
    self.style_2_tag = gui.get_node("style_2_tag")
    self.style_2_check = gui.get_node("style_2_check")
    self.style_3_card = gui.get_node("style_3_card")
    self.style_3_lbl = gui.get_node("style_3_lbl")
    self.style_3_tag = gui.get_node("style_3_tag")
    self.style_3_check = gui.get_node("style_3_check")
    self.btn_confirm_style = gui.get_node("btn_confirm_style")
    self.lbl_confirm_style = gui.get_node("lbl_confirm_style")

    -- Load persistent save data and instantiate controller
    self.save_data = save_manager.load()
    local p = self.save_data.player or {}
    self.ledger = ledger.new({
        balances = {
            stars = p.stars or 0,
            coins = p.coins or 100,
            boosters = p.inventory or { hammer = 1, rocket = 1, bomb = 1 }
        },
        history = self.save_data.ledger_history or {}
    })
    self.village = village_state.new(self.save_data.village, self.ledger)
    self.companion = companion.new("Pip")
    self.ctrl = village_controller.new(self.village, self.companion, self.ledger)

    -- Trigger introduction lore conversation if not yet seen
    if not self.save_data.village.intro_seen then
        dialogue_controller.start_conversation(self.dialogue, "bramble_intro")
        self.save_data.village.intro_seen = true
        save_manager.save(self.save_data)
    end

    refresh_view(self)
end

--- Handles dispatched messages for syncing village state.
-- @param self table GUI script instance table.
-- @param message_id hash Message identifier.
-- @param message table Message payload table.
-- @param sender url Dispatcher sender URL.
function on_message(self, message_id, message, sender)
    if message_id == hash("refresh_village_ui") then
        refresh_view(self)
    elseif message_id == hash("update_companion") then
        if message.dialogue then
            self.companion.dialogue = message.dialogue
        end
        if message.state then
            self.companion.current_emote = message.state
        end
        refresh_view(self)
    end
end

--- Updates companion emote timers and refreshes speech bubble when transitioning.
-- @param self table GUI script instance table.
-- @param dt number Delta time in seconds since previous frame.
function update(self, dt)
    if self.companion and self.companion.emote_timer > 0 then
        local prev_emote = self.companion.current_emote
        companion.update(self.companion, dt)
        if self.companion.current_emote ~= prev_emote then
            refresh_view(self)
        end
    end
end

--- Handles user touch clicks across dialogue, tabs, drawer, styles, and diorama props.
-- @param self table GUI script instance table.
-- @param action_id hash Action identifier (e.g. hash("touch")).
-- @param action table Action event data {x, y, pressed, released}.
-- @return boolean consumed True if touch event was processed.
function on_input(self, action_id, action)
    if action_id ~= hash("touch") then return false end
    if not action.pressed then return false end

    -- 1. Narrative Dialogue Box (Intercepts all clicks when active)
    if self.dialogue and self.dialogue.is_active then
        dialogue_controller.advance(self.dialogue)
        refresh_view(self)
        return true
    end

    -- 2. Picker Modal Clicks (Modal blocks clicks behind it)
    if self.ctrl and self.ctrl.picker_open then
        if gui.pick_node(self.style_1_card, action.x, action.y) then
            village_controller.select_style(self.ctrl, 1)
            refresh_view(self)
            return true
        elseif gui.pick_node(self.style_2_card, action.x, action.y) then
            village_controller.select_style(self.ctrl, 2)
            refresh_view(self)
            return true
        elseif gui.pick_node(self.style_3_card, action.x, action.y) then
            village_controller.select_style(self.ctrl, 3)
            refresh_view(self)
            return true
        elseif gui.pick_node(self.btn_confirm_style, action.x, action.y) then
            local ok, res = village_controller.confirm_selection(self.ctrl)
            if ok then
                self.save_data.player.stars = ledger.get_balance(self.ledger, "stars")
                self.save_data.village.completed_tasks = self.village.completed_tasks
                self.save_data.village.chosen_styles = self.village.chosen_styles
                self.save_data.ledger_history = self.ledger.history
                save_manager.save(self.save_data)
                refresh_view(self)
                pcall(msg.post, "#village", "refresh_props")
            end
            return true
        elseif gui.pick_node(self.btn_cancel_picker, action.x, action.y) then
            village_controller.close_picker(self.ctrl)
            refresh_view(self)
            return true
        end
        return true
    end

    -- 3. Top Navigation Bar
    if gui.pick_node(self.btn_back, action.x, action.y) then
        pcall(msg.post, "main:/controller#flow", "switch_to", { scene = "map" })
        return true
    end

    -- 4. Area Navigation Tabs
    if gui.pick_node(self.tab_area_1, action.x, action.y) then
        self.active_area_id = "area_1"
        refresh_view(self)
        return true
    elseif gui.pick_node(self.tab_area_2, action.x, action.y) then
        local completed_count = #(self.village.completed_tasks or {})
        local current_level = (self.save_data.player and self.save_data.player.current_level) or 1
        local unl = area_catalog.is_area_unlocked("area_2", completed_count, current_level)
        if unl then
            self.active_area_id = "area_2"
        else
            dialogue_controller.start_custom(self.dialogue, "bramble", "The Whispering Willow Pond lies beyond thick shadows! Restore all 12 Courtyard tasks or reach Level 25 to part the mist.")
        end
        refresh_view(self)
        return true
    elseif gui.pick_node(self.tab_area_3, action.x, action.y) then
        local completed_count = #(self.village.completed_tasks or {})
        local current_level = (self.save_data.player and self.save_data.player.current_level) or 1
        local unl = area_catalog.is_area_unlocked("area_3", completed_count, current_level)
        if unl then
            self.active_area_id = "area_3"
        else
            dialogue_controller.start_custom(self.dialogue, "bramble", "Firefly Ridge is steeped in ancient gloom. Restore 28 grove features or reach Level 55 to climb the lantern heights.")
        end
        refresh_view(self)
        return true
    end

    -- 5. Interactive NPC Guide (Elder Bramble)
    if self.npc_bramble and gui.pick_node(self.npc_bramble, action.x, action.y) then
        local completed_count = #(self.village.completed_tasks or {})
        local hearth_done = village_state.is_task_completed(self.village, "repair_stone_hearth")
        if completed_count >= 12 then
            dialogue_controller.start_conversation(self.dialogue, "bramble_courtyard_complete")
        elseif hearth_done and not self.save_data.village.hearth_talk_seen then
            dialogue_controller.start_conversation(self.dialogue, "bramble_hearth_restored")
            self.save_data.village.hearth_talk_seen = true
            save_manager.save(self.save_data)
        else
            dialogue_controller.start_idle_line(self.dialogue, "bramble")
        end
        refresh_view(self)
        return true
    end

    -- 6. Companion Pet Diorama Tap (Pip)
    if self.companion_diorama and gui.pick_node(self.companion_diorama, action.x, action.y) then
        dialogue_controller.start_conversation(self.dialogue, "pip_cheer")
        refresh_view(self)
        return true
    end

    -- 7. Drawer Toggle Tab
    if gui.pick_node(self.drawer_tab, action.x, action.y) then
        village_controller.toggle_drawer(self.ctrl)
        refresh_view(self)
        return true
    end

    -- 8. Restore Active Task Button
    if gui.pick_node(self.btn_restore, action.x, action.y) then
        local active = village_state.get_active_task(self.village)
        if active and village_state.can_complete_task(self.village, active.id) then
            village_controller.open_picker(self.ctrl, active.id, "RESTORE")
            refresh_view(self)
        end
        return true
    end

    -- 9. Interactive Diorama Prop Taps (Re-style or Restore)
    if self.prop_nodes and self.ctrl and not self.ctrl.picker_open then
        for _, entry in pairs(self.prop_nodes) do
            if gui.pick_node(entry.node, action.x, action.y) then
                local is_done = village_state.is_task_completed(self.village, entry.def.task_id)
                if is_done then
                    village_controller.open_picker(self.ctrl, entry.def.task_id, "RESTYLE")
                    refresh_view(self)
                    return true
                else
                    local active = village_state.get_active_task(self.village)
                    if active and active.id == entry.def.task_id then
                        if village_state.can_complete_task(self.village, active.id) then
                            village_controller.open_picker(self.ctrl, active.id, "RESTORE")
                        else
                            if not self.ctrl.drawer_open then
                                village_controller.toggle_drawer(self.ctrl)
                            end
                        end
                        refresh_view(self)
                        return true
                    end
                end
            end
        end
    end

    return false
end

--- Releases input focus when finalized.
-- @param self table GUI script instance table.
function final(self)
    msg.post(".", "release_input_focus")
end
