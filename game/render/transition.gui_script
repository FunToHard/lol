--- GUI script driving full-screen curtain fade animations during scene transitions.
-- Blocks user touch input while transitions are in progress to prevent double-activation.

--- Initializes the transition curtain to fully transparent state.
-- @param self table GUI script instance table.
function init(self)
    self.curtain = gui.get_node("curtain")
    self.is_transitioning = false
    gui.set_enabled(self.curtain, false)
    gui.set_color(self.curtain, vmath.vector4(0.05, 0.07, 0.08, 0.0))
end

--- Handles dispatched messages for starting fade-out or fade-in animations.
-- @param self table GUI script instance table.
-- @param message_id hash Message identifier.
-- @param message table Message payload table.
-- @param sender url Dispatcher sender URL.
function on_message(self, message_id, message, sender)
    if message_id == hash("fade_out") then
        self.is_transitioning = true
        gui.set_enabled(self.curtain, true)
        local duration = message.duration or 0.25
        gui.animate(self.curtain, gui.PROP_COLOR, vmath.vector4(0.05, 0.07, 0.08, 1.0), gui.EASING_INOUTQUAD, duration, 0, function()
            msg.post(sender, "fade_out_done")
        end)
    elseif message_id == hash("fade_in") then
        local duration = message.duration or 0.25
        gui.animate(self.curtain, gui.PROP_COLOR, vmath.vector4(0.05, 0.07, 0.08, 0.0), gui.EASING_INOUTQUAD, duration, 0, function()
            self.is_transitioning = false
            gui.set_enabled(self.curtain, false)
            msg.post(sender, "fade_in_done")
        end)
    end
end

--- Consumes touch inputs during active transition fades.
-- @param self table GUI script instance table.
-- @param action_id hash Action identifier.
-- @param action table Input action table.
-- @return boolean consumed True if touch is consumed while transitioning.
function on_input(self, action_id, action)
    if self.is_transitioning then
        return true
    end
    return false
end
