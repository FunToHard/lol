--- GUI script driving the Scrollable 25-Level Winding Map Path.
-- Binds map_controller view snapshots, handles touch dragging, and manages scene flow transitions.

local save_manager = require("game.persistence.save_manager")
local map_controller = require("game.render.map_controller")
local hud_controller = require("game.render.hud_controller")

--- Refreshes map presentation, positions level buttons, and updates star badges.
-- @param self table GUI script instance table.
local function refresh_map_data(self)
    if not self.ctrl then return end
    local view = map_controller.get_view_data(self.ctrl)
    self.max_unlocked = view.max_unlocked

    -- Header stats
    gui.set_text(self.star_text, tostring(view.stars))
    gui.set_text(self.coin_text, hud_controller.format_number(view.coins))

    -- 25 Winding Level Buttons
    for i = 1, #self.level_nodes do
        local node = self.level_nodes[i]
        local lvl = view.levels[i]
        if lvl then
            gui.set_enabled(node.btn, lvl.is_visible)
            gui.set_enabled(node.txt, lvl.is_visible)

            if lvl.is_visible then
                -- Position dynamically with vertical scroll offset
                gui.set_position(node.btn, vmath.vector3(lvl.screen_x, lvl.screen_y, 0))
                gui.set_position(node.txt, vmath.vector3(lvl.screen_x, lvl.screen_y + 10, 0))
                gui.set_position(node.stars, vmath.vector3(lvl.screen_x, lvl.screen_y - 18, 0))

                -- Star badges
                if lvl.is_completed and lvl.stars > 0 then
                    gui.set_enabled(node.stars, true)
                    gui.set_text(node.stars, lvl.stars_text)
                else
                    gui.set_enabled(node.stars, false)
                end

                -- Visual color states
                if lvl.is_current then
                    gui.set_color(node.btn, vmath.vector4(0.25, 0.75, 0.7, 1.0))
                    gui.set_color(node.txt, vmath.vector4(1.0, 1.0, 1.0, 1.0))
                elseif lvl.is_completed then
                    gui.set_color(node.btn, vmath.vector4(0.3, 0.6, 0.4, 1.0))
                    gui.set_color(node.txt, vmath.vector4(1.0, 1.0, 1.0, 1.0))
                else
                    gui.set_color(node.btn, vmath.vector4(0.35, 0.4, 0.45, 0.55))
                    gui.set_color(node.txt, vmath.vector4(0.65, 0.7, 0.75, 0.55))
                end
            else
                gui.set_enabled(node.stars, false)
            end
        end
    end
end

--- Initializes the Level Select Map GUI components, nodes array, and input listener.
-- @param self table GUI script instance table.
function init(self)
    msg.post(".", "acquire_input_focus")

    -- Header references
    self.star_text = gui.get_node("star_text")
    self.coin_icon = gui.get_node("coin_icon")
    self.coin_text = gui.get_node("coin_text")
    self.btn_shop = gui.get_node("btn_shop")
    self.btn_settings = gui.get_node("btn_settings")

    -- Footer references
    self.btn_village = gui.get_node("btn_village")
    self.btn_play_next = gui.get_node("btn_play_next")

    -- Level nodes array (1 to 25)
    self.level_nodes = {}
    for i = 1, map_controller.TOTAL_LEVELS do
        table.insert(self.level_nodes, {
            btn = gui.get_node("lvl_btn_" .. i),
            txt = gui.get_node("lvl_txt_" .. i),
            stars = gui.get_node("lvl_stars_" .. i)
        })
    end

    -- Drag scroll tracking state
    self.touch_start_y = 0
    self.touch_last_y = 0
    self.is_dragging = false

    self.save_data = save_manager.load()
    self.ctrl = map_controller.new(self.save_data)
    refresh_map_data(self)
end

--- Handles dispatched messages for refreshing map state upon re-entry.
-- @param self table GUI script instance table.
-- @param message_id hash Message identifier.
-- @param message table Message payload table.
-- @param sender url Dispatcher sender URL.
function on_message(self, message_id, message, sender)
    if message_id == hash("refresh") then
        self.save_data = save_manager.load()
        self.ctrl = map_controller.new(self.save_data)
        refresh_map_data(self)
    end
end

--- Handles touch and drag input events for scrolling and launching levels.
-- @param self table GUI script instance table.
-- @param action_id hash Action identifier.
-- @param action table Input action event table.
-- @return boolean consumed True if touch was consumed.
function on_input(self, action_id, action)
    if action_id ~= hash("touch") then
        return false
    end

    -- Touch Start
    if action.pressed then
        self.touch_start_y = action.y
        self.touch_last_y = action.y
        self.is_dragging = false
        return false
    end

    -- Touch Drag Scrolling
    if not action.released then
        local dy = action.y - self.touch_last_y
        if math.abs(action.y - self.touch_start_y) > 12 then
            self.is_dragging = true
        end
        if self.is_dragging and math.abs(dy) > 0.5 then
            map_controller.scroll_by(self.ctrl, dy)
            self.touch_last_y = action.y
            refresh_map_data(self)
            return true
        end
        return false
    end

    -- Touch Released (Tap Handling if not dragged)
    if action.released and not self.is_dragging then
        -- Settings Button
        if gui.pick_node(self.btn_settings, action.x, action.y) then
            pcall(msg.post, "#settings_gui", "show_settings")
            return true
        end

        -- Shop Button & Coin Taps
        if gui.pick_node(self.btn_shop, action.x, action.y) or gui.pick_node(self.coin_icon, action.x, action.y) or gui.pick_node(self.coin_text, action.x, action.y) then
            pcall(msg.post, "#shop_gui", "show_shop", { tab = "packs" })
            return true
        end

        -- Village Scene Switch
        if gui.pick_node(self.btn_village, action.x, action.y) then
            pcall(msg.post, "main:/controller#flow", "switch_to", { scene = "village" })
            return true
        end

        -- Play Next Button
        if gui.pick_node(self.btn_play_next, action.x, action.y) then
            local lvl = self.max_unlocked or 1
            pcall(msg.post, "main:/controller#flow", "switch_to", { scene = "puzzle", level_id = lvl })
            return true
        end

        -- Level Buttons (1 to 25)
        for i = 1, #self.level_nodes do
            local node = self.level_nodes[i]
            if gui.is_enabled(node.btn) and gui.pick_node(node.btn, action.x, action.y) then
                if i <= self.max_unlocked then
                    pcall(msg.post, "main:/controller#flow", "switch_to", { scene = "puzzle", level_id = i })
                end
                return true
            end
        end
    end

    return false
end

--- Releases input focus when the map scene component is disabled or finalized.
-- @param self table GUI script instance table.
function final(self)
    msg.post(".", "release_input_focus")
end
