    z: 0.0
    w: 1.0
  }
  scale {
    x: 1.0
    y: 1.0
    z: 1.0
  }
  size {
    x: 720.0
    y: 1280.0
    z: 0.0
  }
  color {
    x: 0.05
    y: 0.07
    z: 0.08
    w: 0.0
  }
  type: TYPE_BOX
  blend_mode: BLEND_MODE_ALPHA
  id: "curtain"
